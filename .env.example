# ==========================================
# POLESTAR LIVE CS PORTAL CONFIGURATION
# ==========================================

# 1. Supabase Database Configuration (https://supabase.com)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# 2. ImageKit Media Storage Configuration (https://imagekit.io)
VITE_IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key-here
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# 3. Claude API key for the AI email reader (server-side only)
# Do NOT prefix with VITE_ - that would expose it to the browser.
# Locally: put it in .env. On Vercel: Project Settings > Environment Variables.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
